# Backend API (Express) - backend runs on port 5001 (5000 often used by macOS AirPlay)
NEXT_PUBLIC_API_URL=http://localhost:5001

# Google Sign-In — Web application OAuth Client ID (same value as GOOGLE_CLIENT_ID in API .env)
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs → your WEB client
# Under "Authorized JavaScript origins" add EXACTLY where the app runs, e.g.:
#   http://localhost:3000
#   http://127.0.0.1:3000
# Missing origins → "no registered origin" / Error 401: invalid_client
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Maps (pin selection)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCogv2wqVeB17z_2l5g3RL_lXnyWutObZo

# Stripe (optional - for subscription checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID_MONTHLY=price_xxx
